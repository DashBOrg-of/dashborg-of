{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DashBOrg snapshot",
  "type": "object",
  "required": ["schema", "observedAt", "identity", "sources", "health"],
  "properties": {
    "schema": { "const": "dashborg.snapshot.v0" },
    "observedAt": { "type": "string", "format": "date-time" },
    "identity": { "type": "object", "required": ["type", "slug", "displayName"] },
    "surfaces": { "type": "array" },
    "sources": { "type": "array" },
    "health": { "type": "object", "required": ["state", "observedAt"] }
  }
}
